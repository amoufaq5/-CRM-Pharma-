{
  "name": "@crm/acl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures.d.ts",
      "import": "./dist/fixtures.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "erp:codegen": "tsc && node dist/bin/codegen.js",
    "erp:codegen:baseline": "tsc && node dist/bin/codegen.js --from schema/baseline.json",
    "erp:codegen:check": "tsc && node dist/bin/codegen.js --from schema/baseline.json --check"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "bin": {
    "erp-codegen": "./dist/bin/codegen.js"
  }
}
