# deploy/.env.example — copy to deploy/.env and fill in.
#
# deploy/.env is gitignored. Nothing in this file is a real value; every secret
# below is a placeholder and will not work until replaced.
#
# Two identities on purpose (see deploy/README.md §Two database identities):
#   POSTGRES_USER     the admin. Used by `migrate` ONLY.
#   crm_app           the runtime. Not named here — the compose file hardcodes
#                     it, because an app service connecting as the admin would
#                     silently void tenant isolation.

# ---- database ---------------------------------------------------------------

# In the real deployment this points at the ERP's existing Postgres and the `db`
# service is removed; see deploy/README.md. Default `db` is the bundled one.
PGHOST=db
PGPORT=5432

# The database the CrossEngin ERP already lives in. The CRM adds a `crm` schema
# to it; it does not get a database of its own (ADR-0001 option b).
POSTGRES_DB=crossengin

# Admin credentials. Needed because migration 0001 does CREATE ROLE and 0002
# does CREATE EXTENSION — neither of which crm_app can do, and neither of which
# it should be able to do.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-admin

# The password `migrate` sets on crm_app, and that api/scheduler connect with.
# Set it here and the runner applies it on every deploy: rotating it means
# changing this value and re-running `migrate`, nothing more.
CRM_APP_PASSWORD=change-me-app

# ---- human authentication (api) ---------------------------------------------
#
# Any OIDC provider. RS256 is fine for these — a human token is short-lived and
# IdP-issued. This is NOT the credential used to call the ERP; see below.
#
# A valid token is not authorisation: the API resolves `sub` through
# crm.rep_profile and a subject with no profile gets 403, not a default role.
OIDC_ISSUER=https://your-idp.example.com/
OIDC_AUDIENCE=crm-pharma
OIDC_JWKS_URL=https://your-idp.example.com/.well-known/jwks.json

# ---- ERP access (scheduler) -------------------------------------------------

# Where operate-server is reachable. Same cluster network in the bundled stack;
# a private address in a real deployment — this is an unauthenticated-at-the-edge
# admin surface and must not be published.
ERP_BASE_URL=http://erp-api:8080

# DEVELOPMENT ONLY. The scheduler refuses to start with this when
# NODE_ENV=production, which is the default for that service. To run the
# scheduler locally against a dev ERP, set BOTH:
#   ERP_TOKEN=<a token minted by the ERP>
#   SCHEDULER_NODE_ENV=development
# Production mints short-lived per-tenant Ed25519 service JWTs instead
# (ADR-0001 item 10) — that work is open, so in production the scheduler
# currently cannot talk to the ERP at all. Deliberate: a static shared secret
# with `controller` on every tenant is worse than no relay.
ERP_TOKEN=
SCHEDULER_NODE_ENV=production

# ---- TLS edge ---------------------------------------------------------------

# Caddy obtains a certificate for this name automatically, which means it must
# already resolve to this host and 80/443 must be reachable. Use `localhost` for
# local work — Caddy then issues its own internal certificate instead.
DOMAIN=crm.example.com
ACME_EMAIL=ops@example.com

# ---- optional tuning --------------------------------------------------------

# PG_POOL_MAX=10          per-process connection pool ceiling (api and scheduler)
# TICK_INTERVAL_MS=5000   scheduler poll interval
# CRM_APP_ROLE=crm_app    only if the role was provisioned under another name
